{
  "name": "armory-extension-wow",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:token": "node ./scripts/dev-token.mjs",
    "build": "tsc -b && vite build",
    "release": "yarn build && ./scripts/zip.sh && yarn sync && yarn invalidate",
    "sync": "aws s3 sync ./dist s3://wow-extension-landing-page --exclude \"*\" --include \"landing.html\" --include \"assets/landing-*\" --include \"assets/main-*\"",
    "invalidate": "aws cloudfront create-invalidation --distribution-id ECKCFNPG4IIL --paths \"/*\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.2",
    "@types/react-window": "^1.8.8",
    "@uidotdev/usehooks": "^2.4.1",
    "@uiw/react-color": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.483.0",
    "motion": "^12.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "9.6.3",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-virtualized": "^9.22.6",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11",
    "simplebar-react": "^3.3.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "vite-plugin-rewrite": "^0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.5",
    "@types/react-virtualized": "^9.22.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3"
  }
}
