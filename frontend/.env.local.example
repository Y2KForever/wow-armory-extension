# Copy to `.env.local` (gitignored) to run the extension outside of Twitch.
# Only read in dev builds, by src/dev/twitchMock.ts.

# Signed Twitch extension JWT. Generate with:
#   yarn dev:token --secret <base64-secret-from-twitch-console>
VITE_DEV_TWITCH_TOKEN=

# Used only when no token is set — lets the UI render without a working API.
VITE_DEV_CHANNEL_ID=72606078

# Optional, mirrors the clientId Twitch passes to onAuthorized.
VITE_DEV_CLIENT_ID=
